{
  "title": "OptiQuant — Alerts",
  "uid": "optiquant-alerts",
  "tags": ["optiquant", "alerts"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Firing Alerts",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(ALERTS{alertstate=\"firing\"})", "legendFormat": "firing" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pending Alerts",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(ALERTS{alertstate=\"pending\"})", "legendFormat": "pending" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(optiquant_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(optiquant_http_requests_total[5m])), 0.0001)", "legendFormat": "5xx rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency Alert Signals",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(optiquant_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "HTTP p99" },
        { "expr": "histogram_quantile(0.95, sum(rate(optiquant_pricing_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Pricing p95" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "WebSocket Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(optiquant_websocket_errors_total[5m])) by (channel, error_type)", "legendFormat": "{{channel}} {{error_type}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
