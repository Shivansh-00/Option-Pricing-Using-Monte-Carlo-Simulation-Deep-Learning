      "title": "Backend Status",
      "type": "stat",
      "targets": [{ "expr": "up{job=\"optiquant-backend\"}", "legendFormat": "Backend" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
