APP_NAME=Intelligent Option Pricing Platform
ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.4

# CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5500

# LLM resilience controls
LLM_MAX_RPM=30
LLM_MAX_TPM=100000
LLM_CB_THRESHOLD=5
LLM_CB_RECOVERY=60

# Runtime lockstep controls
DEPENDENCY_LOCK_FILE=backend/requirements.lock.txt
ENFORCE_DEPENDENCY_PINS=1
ENFORCE_MODEL_COMPATIBILITY=1
