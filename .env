# ══════════════════════════════════════════════════════════════
#  OptionQuant — Environment Configuration
# ══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
APP_NAME=OptionQuant — Intelligent Option Pricing Platform
ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# ── Networking ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8080,http://127.0.0.1:8080,null
FRONTEND_DIR=frontend
MODEL_DIR=backend/models

# ── Auth / JWT ───────────────────────────────────────────────
JWT_SECRET=optiquant-super-secret-key-change-in-production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ── Neon PostgreSQL Database ─────────────────────────────────
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:npg_J5RfEqDihmY4@ep-empty-mud-aeob4jyg.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require
# ── Monte Carlo Engine ───────────────────────────────────────
MAX_MC_PATHS=500000
MAX_MC_STEPS=2000
MC_BATCH=100000

# ── Deep Learning ────────────────────────────────────────────
DL_LSTM_HIDDEN=128
DL_LSTM_LAYERS=2
DL_LSTM_DROPOUT=0.2
DL_LSTM_EPOCHS=100
DL_LSTM_LR=0.001
DL_TRANSFORMER_HEADS=4
DL_TRANSFORMER_LAYERS=2
DL_TRANSFORMER_DIM=64

# ── Groq LLM (RAG) ──────────────────────────────────────────
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.4

# ── RAG Pipeline ─────────────────────────────────────────────
RAG_TOP_K=6
RAG_MIN_SCORE=0.01
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120
RAG_CACHE_MAX=128
RAG_RESPONSE_TTL=600
RAG_MAX_CONTEXT_CHARS=6000
RAG_EMBEDDING_BACKEND=auto
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TFIDF_MAX_FEATURES=8000

# ── Workers ──────────────────────────────────────────────────
UVICORN_WORKERS=2
